{
  "manifest_version": 3,
  "name": "cookieZ - Cookie Editor",
  "version": "1.9.0",
  "description": "View, edit, delete and block cookies. There are no ads, and nothing you do leaves your computer.",
  "homepage_url": "https://github.com/mwc0/cookie-manager",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "cookies",
    "storage"
  ],
  "optional_host_permissions": [
    "*://*/*"
  ],
  "optional_permissions": [
    "contentSettings",
    "privacy",
    "browsingData"
  ],
  "incognito": "split",
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+K"
      }
    }
  },
  "action": {
    "default_title": "cookieZ",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  }
}
